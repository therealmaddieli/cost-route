# Copy to .env and fill in. .env is gitignored - never commit real keys.

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face - https://huggingface.co/settings/tokens
# Needs at least "Make calls to Inference Providers" permission.
HF_TOKEN=

# Black Forest Labs - https://dashboard.bfl.ai -> API -> Keys
# Key starts with bfl_
BFL_API_KEY=

# Optional: use the EU BFL endpoint instead of the default
# BFL_BASE_URL=https://api.eu.bfl.ai/v1
